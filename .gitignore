# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/
frontend/dist/

# Environment files — NEVER commit
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# CDK
infra/cdk.out/
infra/cdk.context.json

# Logs
logs/*.json
logs/reviews/*.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/
**/coverage/

# TypeScript cache
*.tsbuildinfo

# Scripts locais — não versionados (contêm lógica de automação local)
# Exceção: install-hooks.ps1 é versionado para que quem clonar saiba instalar os hooks
scripts/
!scripts/install-hooks.ps1

# Artefatos de estudo pessoal — não pertencem ao repositório do projeto
# Use docs/ para documentação técnica do projeto (versionada)
.docs/
